# Example environment for the demo in the README. dotenv-doctor checks a real
# .env against this file, and checks this file itself for committed secrets.

# Required. The upstream API credential.
API_KEY=

# Required. Postgres connection string.
DATABASE_URL=

# Optional. Port the server binds to.
PORT=3000

# Optional. One of: debug, info, warn, error.
LOG_LEVEL=info
